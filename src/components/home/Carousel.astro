---
import { slides } from "../../data/site";
---

<div class="carousel" data-carousel>
  <div class="carousel-viewport">
    {
      slides.map((slide, index) => (
        <figure
          class:list={["carousel-slide", { "is-active": index === 0 }]}
          data-slide
          data-kicker={slide.kicker}
          data-caption={slide.caption}
        >
          <img src={slide.src} alt={slide.alt} width="1280" height="720" />
        </figure>
      ))
    }
  </div>
  <div class="carousel-bar">
    <div class="carousel-copy">
      <p class="carousel-kicker" data-kicker-text>{slides[0].kicker}</p>
      <p class="carousel-caption" data-caption-text>{slides[0].caption}</p>
    </div>
    <div class="carousel-controls">
      <button type="button" data-prev aria-label="Previous photograph">
        <span aria-hidden="true">‹</span>
      </button>
      <div class="carousel-dots">
        {
          slides.map((slide, index) => (
            <button
              type="button"
              class:list={["carousel-dot", { "is-active": index === 0 }]}
              data-dot={index}
              aria-label={slide.kicker}
              aria-pressed={index === 0 ? "true" : "false"}
            />
          ))
        }
      </div>
      <button type="button" data-next aria-label="Next photograph">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </div>
</div>

<script>
  class LandingCarousel {
    private readonly root: HTMLElement;
    private readonly slides: HTMLElement[];
    private readonly dots: HTMLButtonElement[];
    private readonly kicker: HTMLElement | null;
    private readonly caption: HTMLElement | null;
    private index = 0;
    private timer = 0;

    constructor(root: HTMLElement) {
      this.root = root;
      this.slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
      this.dots = [...root.querySelectorAll<HTMLButtonElement>("[data-dot]")];
      this.kicker = root.querySelector("[data-kicker-text]");
      this.caption = root.querySelector("[data-caption-text]");
      root.querySelector("[data-prev]")?.addEventListener("click", () => {
        this.show(this.index - 1);
      });
      root.querySelector("[data-next]")?.addEventListener("click", () => {
        this.show(this.index + 1);
      });
      this.dots.forEach((dot, dotIndex) => {
        dot.addEventListener("click", () => {
          this.show(dotIndex);
        });
      });
      root.addEventListener("mouseenter", () => this.stop());
      root.addEventListener("mouseleave", () => this.start());
      root.addEventListener("focusin", () => this.stop());
      root.addEventListener("focusout", () => this.start());
      this.start();
    }

    private show(next: number) {
      const count = this.slides.length;
      if (count === 0) {
        return;
      }
      this.index = (next + count) % count;
      this.slides.forEach((slide, slideIndex) => {
        slide.classList.toggle("is-active", slideIndex === this.index);
      });
      this.dots.forEach((dot, dotIndex) => {
        const active = dotIndex === this.index;
        dot.classList.toggle("is-active", active);
        dot.setAttribute("aria-pressed", active ? "true" : "false");
      });
      const current = this.slides[this.index];
      if (this.kicker) {
        this.kicker.textContent = current.dataset.kicker ?? "";
      }
      if (this.caption) {
        this.caption.textContent = current.dataset.caption ?? "";
      }
    }

    private start() {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || this.slides.length < 2 || this.timer) {
        return;
      }
      this.timer = window.setInterval(() => this.show(this.index + 1), 7000);
    }

    private stop() {
      window.clearInterval(this.timer);
      this.timer = 0;
    }
  }

  const carousel = document.querySelector("[data-carousel]");
  if (carousel instanceof HTMLElement) {
    new LandingCarousel(carousel);
  }
</script>
