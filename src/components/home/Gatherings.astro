---
import SectionIntro from "../SectionIntro.astro";
import { gatherings, standingGatherings } from "../../data/site";
---

<section id="events" class="section" aria-labelledby="events-title">
  <div class="wrap">
    <SectionIntro
      kicker="Events"
      title="Upcoming gatherings"
      titleId="events-title"
    />
    <p class="measure">
      The Forum brings people together through forums, policy dialogues, academic
      exchange, and cultural meetings between Japan and Bangladesh.
    </p>
    {
      gatherings.length > 0 && (
        <div class="event-grid">
          {gatherings.map((item) => (
            <article class="event-card">
              <img src={item.src} alt={item.alt} width="1280" height="720" />
              <div class="event-body">
                <p class="schedule-when">
                  {item.when} · {item.place}
                </p>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
              </div>
            </article>
          ))}
        </div>
      )
    }
    <div class="pillar-grid standing-grid">
      {
        standingGatherings.map((item) => (
          <article class="pillar pillar-note">
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
