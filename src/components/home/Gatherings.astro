---
import SectionIntro from "../SectionIntro.astro";
import { gatherings, standingGatherings } from "../../data/site";
---

<section id="gatherings" class="section section-ivory" aria-labelledby="gatherings-title">
  <div class="wrap">
    <SectionIntro
      kicker="Gatherings"
      title="Forums, dialogues, and exchange"
      titleId="gatherings-title"
    />
    <p class="measure">
      The Forum brings people together through forums, policy dialogues, academic
      exchange, and cultural meetings between Japan and Bangladesh.
    </p>
    {
      gatherings.length > 0 && (
        <ul class="schedule">
          {gatherings.map((item) => (
            <li>
              <p class="schedule-when">
                {item.when}
                {item.place ? ` · ${item.place}` : ""}
              </p>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
    <div class="pillar-grid standing-grid">
      {
        standingGatherings.map((item) => (
          <article class="pillar">
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
