---
import SectionIntro from "../SectionIntro.astro";
import { bulletin, news } from "../../data/site";
---

<section id="news" class="section" aria-labelledby="news-title">
  <div class="wrap">
    <SectionIntro kicker="News" title={news.title} titleId="news-title" />
    <p class="measure">{news.body}</p>
    {
      bulletin.length > 0 && (
        <ul class="schedule">
          {bulletin.map((item) => (
            <li>
              <p class="schedule-when">{item.date}</p>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
