---
import SectionIntro from "../SectionIntro.astro";
import { programmes } from "../../data/site";
---

<section id="programmes" class="section" aria-labelledby="programmes-title">
  <div class="wrap">
    <SectionIntro
      kicker="Programmes"
      title="Culture, education, youth, and sustainable development"
      titleId="programmes-title"
    />
    <div class="programme-list">
      {
        programmes.map((programme, index) => (
          <article
            class:list={[
              "programme-row",
              { "programme-row-flip": index % 2 === 1 },
            ]}
          >
            <img
              class="split-media"
              src={programme.src}
              alt={programme.alt}
              width="1152"
              height="864"
            />
            <div class="programme-copy">
              <h3>{programme.title}</h3>
              {programme.summary && <p>{programme.summary}</p>}
              {programme.points && (
                <ul>
                  {programme.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
